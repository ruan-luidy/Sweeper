<!-- CanMinimize: redimensionar na mão desligaria o SizeToContent nos jogos seguintes. -->
<hc:Window x:Class="Sweeper.Wpf.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:board="clr-namespace:Sweeper.Wpf.Features.Board"
           xmlns:game="clr-namespace:Sweeper.Wpf.Features.Game"
           Title="Sweeper"
           Background="{DynamicResource SecondaryRegionBrush}"
           WindowStartupLocation="CenterScreen"
           SizeToContent="WidthAndHeight"
           ResizeMode="CanMinimize"
           MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
           MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}">
  <hc:Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Cartão branco com a sombra do HandyControl; Margin deixa espaço pra sombra não ser cortada. -->
    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource BorderRegion}">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Effect" Value="{StaticResource EffectShadow2}" />
    </Style>
  </hc:Window.Resources>

  <DockPanel Margin="20">
    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,0,16">
      <game:GameHeaderView />
    </Border>

    <!-- Faixa do coop: só aparece conectado. -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,6" Margin="0,0,0,16"
            Background="{DynamicResource LightPrimaryBrush}"
            Visibility="{Binding IsCoop, Converter={StaticResource BooleanToVisibilityConverter}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Sair do coop" Command="{Binding LeaveCoopCommand}"
                Focusable="False" Style="{StaticResource ButtonDefault.Small}" />
        <Path Data="{StaticResource UsersGeometry}" Fill="{DynamicResource PrimaryBrush}" Width="16" Height="16"
              Stretch="Uniform" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CoopText}" Margin="8,0,12,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}" Padding="12">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <board:BoardView HorizontalAlignment="Center" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</hc:Window>
