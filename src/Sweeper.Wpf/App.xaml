<!-- Sem StartupUri: a janela é criada no OnStartup, porque o MainViewModel precisa de parâmetros. -->
<Application x:Class="Sweeper.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
        <ResourceDictionary Source="Resources/Icons.xaml" />
        <ResourceDictionary Source="Resources/Emoji.xaml" />
        <ResourceDictionary Source="Resources/CellStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Cartão branco com a sombra do HandyControl, usado nas duas telas. -->
      <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource BorderRegion}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Effect" Value="{StaticResource EffectShadow2}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
