<!-- Nos triggers, o último que se aplica vence. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:board="clr-namespace:Sweeper.Wpf.Features.Board"
                    xmlns:shared="clr-namespace:Sweeper.Core.Shared;assembly=Sweeper.Core">

  <board:NumberToBrushConverter x:Key="NumberToBrushConverter" />

  <!-- Border em vez de Button: bem mais leve com até 2500 células. -->
  <Style x:Key="CellBorderStyle" TargetType="Border">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
          <Condition Binding="{Binding State}" Value="{x:Static shared:CellState.Hidden}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static shared:CellState.Revealed}">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsExploded}" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CellNumberStyle" TargetType="TextBlock">
    <Setter Property="Text" Value="{Binding AdjacentMines}" />
    <Setter Property="Foreground" Value="{Binding AdjacentMines, Converter={StaticResource NumberToBrushConverter}}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding AdjacentMines}" Value="0">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CellIconStyle" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Visibility" Value="Collapsed" />
  </Style>

  <Style x:Key="CellFlagStyle" TargetType="Path" BasedOn="{StaticResource CellIconStyle}">
    <Setter Property="Data" Value="{StaticResource FlagGeometry}" />
    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="{x:Static shared:CellState.Flagged}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Mina fechada no fim do jogo, ou a que explodiu (branca no fundo vermelho). -->
  <Style x:Key="CellMineStyle" TargetType="Path" BasedOn="{StaticResource CellIconStyle}">
    <Setter Property="Data" Value="{StaticResource MineGeometry}" />
    <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}" />
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMine}" Value="True" />
          <Condition Binding="{Binding State}" Value="{x:Static shared:CellState.Hidden}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Visible" />
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding IsExploded}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="Fill" Value="{DynamicResource TextIconBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
