<!-- Ícones em 24x24; o tamanho final vem do Path que usa. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Geometry x:Key="FlagGeometry">
    M 8,3 H 10 V 19 H 8 Z
    M 10,3 L 19,7.5 L 10,12 Z
    M 5,19 H 14 V 21 H 5 Z
  </Geometry>

  <!-- Nonzero une as formas em vez de furar onde se sobrepõem. -->
  <GeometryGroup x:Key="MineGeometry" FillRule="Nonzero">
    <EllipseGeometry Center="12,12" RadiusX="7" RadiusY="7" />
    <RectangleGeometry Rect="11,2,2,20" />
    <RectangleGeometry Rect="2,11,20,2" />
    <RectangleGeometry Rect="11,4,2,16">
      <RectangleGeometry.Transform>
        <RotateTransform Angle="45" CenterX="12" CenterY="12" />
      </RectangleGeometry.Transform>
    </RectangleGeometry>
    <RectangleGeometry Rect="11,4,2,16">
      <RectangleGeometry.Transform>
        <RotateTransform Angle="-45" CenterX="12" CenterY="12" />
      </RectangleGeometry.Transform>
    </RectangleGeometry>
  </GeometryGroup>

</ResourceDictionary>
