<!--
  Fluent Emoji 3D da Microsoft (MIT). Os PNGs são 256x256; DecodePixelWidth decodifica já pequeno,
  o que economiza memória (o mesmo bitmap é usado por até 2500 células) e deixa a redução mais suave.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <BitmapImage x:Key="BombEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/bomb.png" DecodePixelWidth="64" />
  <BitmapImage x:Key="CollisionEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/collision.png" DecodePixelWidth="64" />
  <BitmapImage x:Key="StopwatchEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/stopwatch.png" DecodePixelWidth="64" />

  <BitmapImage x:Key="FaceHappyEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/face-happy.png" DecodePixelWidth="96" />
  <BitmapImage x:Key="FaceNervousEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/face-nervous.png" DecodePixelWidth="96" />
  <BitmapImage x:Key="FaceSweatingEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/face-sweating.png" DecodePixelWidth="96" />
  <BitmapImage x:Key="FaceWonEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/face-won.png" DecodePixelWidth="96" />
  <BitmapImage x:Key="FaceLostEmoji" UriSource="pack://application:,,,/Sweeper.Wpf;component/Resources/Emoji/face-lost.png" DecodePixelWidth="96" />

  <Style x:Key="EmojiImageStyle" TargetType="Image">
    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

</ResourceDictionary>
