<UserControl x:Class="Sweeper.Wpf.Features.Game.GameHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:game="clr-namespace:Sweeper.Wpf.Features.Game">
  <Grid>
    <!-- Colunas laterais iguais mantêm a carinha centralizada. -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Minas restantes">
      <Image Source="{StaticResource BombEmoji}" Style="{StaticResource EmojiImageStyle}" Width="28" Height="28" />
      <TextBlock Text="{Binding MinesRemaining}" Margin="8,0,0,0" FontSize="20" FontWeight="Bold"
                 VerticalAlignment="Center" />
    </StackPanel>

    <!-- Novo jogo, no estilo do Campo Minado clássico: a carinha é o botão. Focusable False tira o contorno tracejado de foco. -->
    <Button Grid.Column="1" Command="{Binding NewGameCommand}" ToolTip="Novo jogo" Focusable="False"
            Width="52" Height="52" Padding="8" Margin="16,0">
      <Image>
        <Image.Style>
          <Style TargetType="Image" BasedOn="{StaticResource EmojiImageStyle}">
            <Setter Property="Source" Value="{StaticResource FaceHappyEmoji}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Nervous}">
                <Setter Property="Source" Value="{StaticResource FaceNervousEmoji}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Sweating}">
                <Setter Property="Source" Value="{StaticResource FaceSweatingEmoji}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Won}">
                <Setter Property="Source" Value="{StaticResource FaceWonEmoji}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Lost}">
                <Setter Property="Source" Value="{StaticResource FaceLostEmoji}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Image.Style>
      </Image>
    </Button>

    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="ToolTip" Value="Tempo" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasTimeLimit}" Value="True">
                <Setter Property="ToolTip" Value="Tempo restante" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Image Source="{StaticResource StopwatchEmoji}" Style="{StaticResource EmojiImageStyle}" Width="28" Height="28" />
        <TextBlock Text="{Binding TimeText}" Margin="8,0,0,0" FontSize="20" FontWeight="Bold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <Button Command="{Binding OpenSettingsCommand}" ToolTip="Configurações" Focusable="False" Margin="16,0,0,0"
              Style="{StaticResource ButtonIcon}"
              Foreground="{DynamicResource SecondaryTextBrush}"
              hc:IconElement.Geometry="{StaticResource GearGeometry}"
              hc:IconElement.Width="20" />
    </StackPanel>
  </Grid>
</UserControl>
