<UserControl
  x:Class="Sweeper.Wpf.Features.Game.GameHeaderView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:game="clr-namespace:Sweeper.Wpf.Features.Game"
  xmlns:hc="https://handyorg.github.io/handycontrol">
  <Grid>
    <!--  Colunas laterais iguais mantêm a carinha centralizada.  -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel
      Grid.Column="0"
      VerticalAlignment="Center"
      Orientation="Horizontal"
      ToolTip="Minas restantes">
      <Image
        Width="28"
        Height="28"
        Source="{StaticResource BombEmoji}"
        Style="{StaticResource EmojiImageStyle}" />
      <TextBlock
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        FontSize="20"
        FontWeight="Bold"
        Text="{Binding MinesRemaining}" />
    </StackPanel>

    <!--  Novo jogo, no estilo do Campo Minado clássico: a carinha é o botão. Focusable False tira o contorno tracejado de foco.  -->
    <Button
      Grid.Column="1"
      Width="52"
      Height="52"
      Margin="16,0"
      Padding="8"
      BorderThickness="0"
      Command="{Binding NewGameCommand}"
      Focusable="False"
      ToolTip="Novo jogo">
      <Image>
        <Image.Style>
          <Style BasedOn="{StaticResource EmojiImageStyle}" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource FaceHappyEmoji}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Nervous}">
                <Setter Property="Source" Value="{StaticResource FaceNervousEmoji}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Sweating}">
                <Setter Property="Source" Value="{StaticResource FaceSweatingEmoji}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Won}">
                <Setter Property="Source" Value="{StaticResource FaceWonEmoji}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Face}" Value="{x:Static game:GameFace.Lost}">
                <Setter Property="Source" Value="{StaticResource FaceLostEmoji}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Image.Style>
      </Image>
    </Button>

    <StackPanel
      Grid.Column="2"
      HorizontalAlignment="Right"
      VerticalAlignment="Center"
      Orientation="Horizontal">
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="ToolTip" Value="Tempo" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasTimeLimit}" Value="True">
                <Setter Property="ToolTip" Value="Tempo restante" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Image
          Width="28"
          Height="28"
          Source="{StaticResource StopwatchEmoji}"
          Style="{StaticResource EmojiImageStyle}" />
        <TextBlock
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          FontSize="20"
          FontWeight="Bold"
          Text="{Binding TimeText}" />
      </StackPanel>

      <!--  Escondido durante o coop; pra sair tem o botão na faixa de baixo do cabeçalho.  -->
      <Button
        Margin="16,0,0,0"
        hc:IconElement.Geometry="{StaticResource UsersGeometry}"
        hc:IconElement.Width="20"
        Command="{Binding OpenCoopCommand}"
        Focusable="False"
        Foreground="{DynamicResource SecondaryTextBrush}"
        ToolTip="Coop na rede local">
        <Button.Style>
          <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCoop}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>

      <Button
        Margin="8,0,0,0"
        hc:IconElement.Geometry="{StaticResource GearGeometry}"
        hc:IconElement.Width="20"
        Command="{Binding OpenSettingsCommand}"
        Focusable="False"
        Foreground="{DynamicResource SecondaryTextBrush}"
        Style="{StaticResource ButtonIcon}"
        ToolTip="Configurações" />
    </StackPanel>
  </Grid>
</UserControl>
