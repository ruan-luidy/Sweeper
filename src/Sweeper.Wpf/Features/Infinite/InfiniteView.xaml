<!-- Modo infinito: cabeçalho com pontos e modos em cima, mapa ocupando o resto da janela. -->
<UserControl x:Class="Sweeper.Wpf.Features.Infinite.InfiniteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:infinite="clr-namespace:Sweeper.Wpf.Features.Infinite">
  <UserControl.InputBindings>
    <KeyBinding Key="Home" Command="{Binding CenterViewCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="HudNumberStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="HudLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="HudIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonIcon}">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="hc:IconElement.Width" Value="20" />
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="20">
    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,0,16">
      <Grid>
        <!-- Colunas laterais iguais mantêm os modos centralizados. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" ToolTip="Setores resolvidos">
            <Path Data="{StaticResource GridGeometry}" Fill="{DynamicResource SuccessBrush}" Width="20" Height="20"
                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Score}" Style="{StaticResource HudNumberStyle}" />
            <TextBlock Text="setores" Style="{StaticResource HudLabelStyle}" />
          </StackPanel>

          <TextBlock Margin="16,0,0,0" Style="{StaticResource HudLabelStyle}" ToolTip="Melhor pontuação neste modo">
            <Run Text="Recorde" />
            <Run Text="{Binding BestScore, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>

          <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                      ToolTip="Setores travados: resolva os vizinhos pra destravar"
                      Visibility="{Binding HasLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Path Data="{StaticResource LockGeometry}" Fill="{DynamicResource DangerBrush}" Width="14" Height="14"
                  Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LockedCount}" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}" />
          </StackPanel>
        </StackPanel>

        <hc:ButtonGroup Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
          <RadioButton Content="Infinito" IsChecked="{Binding IsEndless}" Focusable="False"
                       ToolTip="Mina trava o setor e o jogo segue" />
          <RadioButton Content="Hardcore" IsChecked="{Binding IsHardcore}" Focusable="False"
                       ToolTip="Uma mina e acabou" />
          <RadioButton Content="Contra o tempo" IsChecked="{Binding IsTimed}" Focusable="False"
                       ToolTip="Quantos setores você resolve em 3 minutos?" />
        </hc:ButtonGroup>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="0,0,8,0" ToolTip="Tempo restante"
                      Visibility="{Binding HasTimeLimit, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Width="28" Height="28" Source="{StaticResource StopwatchEmoji}" Style="{StaticResource EmojiImageStyle}" />
            <TextBlock Text="{Binding TimeText}" Margin="8,0,0,0" Style="{StaticResource HudNumberStyle}" />
          </StackPanel>

          <Button Command="{Binding CenterViewCommand}" ToolTip="Voltar pro começo (Home)"
                  hc:IconElement.Geometry="{StaticResource CrosshairGeometry}" Style="{StaticResource HudIconButtonStyle}" />
          <Button Command="{Binding NewWorldCommand}" ToolTip="Mundo novo"
                  hc:IconElement.Geometry="{StaticResource RestartGeometry}" Style="{StaticResource HudIconButtonStyle}" />
          <Button Command="{Binding OpenClassicCommand}" ToolTip="Modo clássico"
                  hc:IconElement.Geometry="{StaticResource GridGeometry}" Style="{StaticResource HudIconButtonStyle}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Padding pra os cantos quadrados do mapa não vazarem pelos cantos arredondados do cartão. -->
    <Border Style="{StaticResource CardStyle}" Padding="6">
      <Grid>
        <infinite:InfiniteBoardView Game="{Binding Game}" Camera="{Binding Camera}"
                                    RevealCommand="{Binding RevealCommand}" FlagCommand="{Binding ToggleFlagCommand}" />

        <!-- Dica de controles até o primeiro clique. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Padding="14,8"
                CornerRadius="8" Background="{DynamicResource RegionBrush}" Effect="{StaticResource EffectShadow2}"
                IsHitTestVisible="False"
                Visibility="{Binding IsReady, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="Clique em qualquer lugar pra começar · arraste pra mover · roda do mouse pra zoom" />
        </Border>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
          <Button Command="{Binding ZoomInCommand}" ToolTip="Aproximar" Margin="0,0,0,6"
                  hc:IconElement.Geometry="{StaticResource PlusGeometry}" hc:IconElement.Width="14"
                  Style="{StaticResource ButtonDefault}" Focusable="False" Width="34" Height="34" Padding="0" />
          <Button Command="{Binding ZoomOutCommand}" ToolTip="Afastar"
                  hc:IconElement.Geometry="{StaticResource MinusGeometry}" hc:IconElement.Width="14"
                  Style="{StaticResource ButtonDefault}" Focusable="False" Width="34" Height="34" Padding="0" />
        </StackPanel>

        <!-- Fim do Hardcore ou do contra o tempo. -->
        <Border Background="#66000000" CornerRadius="6"
                Visibility="{Binding IsOver, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20" MinWidth="280"
                  CornerRadius="10" Background="{DynamicResource RegionBrush}" Effect="{StaticResource EffectShadow3}">
            <StackPanel>
              <TextBlock Text="{Binding OverTitle}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{Binding OverText}" Margin="0,8,0,0" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <Button Content="Jogar de novo" Command="{Binding NewWorldCommand}" Margin="0,16,0,0"
                      HorizontalAlignment="Center" Width="140" Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
