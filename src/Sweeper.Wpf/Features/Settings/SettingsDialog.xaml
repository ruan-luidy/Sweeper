<!-- Abre com hc:Dialog, por cima da janela principal. Cartão com cabeçalho, corpo e rodapé cinza. -->
<UserControl x:Class="Sweeper.Wpf.Features.Settings.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Width="384">
  <!-- Dentro do hc:Dialog não tem IsDefault/IsCancel (não é janela), então Enter e Esc vão por KeyBinding. -->
  <UserControl.InputBindings>
    <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- Cada dificuldade é um cartão; o selecionado ganha a borda e o fundo claro do PrimaryBrush. -->
    <Style x:Key="DifficultyItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Padding="10,8" CornerRadius="8" BorderThickness="1.5"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource SecondaryRegionBrush}">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource BorderBrush}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="10" Effect="{StaticResource EffectShadow3}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Cabeçalho -->
      <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource SecondaryRegionBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding CancelCommand}"
                  ToolTip="Fechar" Focusable="False"
                  Style="{StaticResource ButtonIcon}" Padding="6"
                  Foreground="{DynamicResource SecondaryTextBrush}"
                  hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                  hc:IconElement.Width="12" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Configurações" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Corpo -->
      <StackPanel Grid.Row="1" Margin="16,12">
        <TextBlock Text="Dificuldade" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />

        <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                 ItemContainerStyle="{StaticResource DifficultyItemStyle}"
                 Background="Transparent" BorderThickness="0" Padding="0" Margin="-4,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>

        <!-- Os campos só aparecem no personalizado. Os limites aqui são conforto; quem valida é o GameSettings. -->
        <Grid Margin="0,8,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <hc:NumericUpDown Grid.Column="0" Value="{Binding BoardWidth}" Minimum="5" Maximum="50" DecimalPlaces="0"
                            Style="{StaticResource NumericUpDownExtend}" hc:InfoElement.Title="Largura" />
          <hc:NumericUpDown Grid.Column="2" Value="{Binding BoardHeight}" Minimum="5" Maximum="50" DecimalPlaces="0"
                            Style="{StaticResource NumericUpDownExtend}" hc:InfoElement.Title="Altura" />
          <hc:NumericUpDown Grid.Column="4" Value="{Binding MineCount}" Minimum="1" Maximum="2491" DecimalPlaces="0"
                            Style="{StaticResource NumericUpDownExtend}" hc:InfoElement.Title="Minas" />
        </Grid>

        <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource BorderBrush}" />

        <DockPanel>
          <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding HasTimeLimit}"
                        Style="{StaticResource ToggleButtonSwitch}" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock Text="Limite de tempo" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="Perde a partida quando o tempo acaba" Margin="0,2,0,0" FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
        </DockPanel>

        <hc:NumericUpDown Value="{Binding TimeLimitMinutes}" Minimum="1" Maximum="999" DecimalPlaces="0"
                          Margin="0,8,0,0"
                          Visibility="{Binding HasTimeLimit, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Style="{StaticResource NumericUpDownExtend}"
                          hc:InfoElement.Title="Minutos" />

        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>

      <!-- Rodapé -->
      <Border Grid.Row="2" Padding="16,10" Background="{DynamicResource SecondaryRegionBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding CancelCommand}" Width="96" />
          <Button Content="Salvar" Command="{Binding SaveCommand}" Width="96"
                  Style="{StaticResource ButtonPrimary}" Margin="8,0,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
